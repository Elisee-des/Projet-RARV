# =====================================================================
#  RARV — plateforme de formation immersive
#  Environnement de PRODUCTION — rarv.kodemeet.com
#
#  Copier en `.env` sur le serveur, puis remplir les valeurs marquées
#  « À REMPLIR ». Ne JAMAIS versionner le fichier complété.
# =====================================================================

APP_NAME="RARV"
APP_ENV=production

# À REMPLIR — générer sur votre machine :  php artisan key:generate --show
APP_KEY=

# false, sans exception : APP_DEBUG=true affiche les traces d'erreur, donc les
# identifiants de base et le contenu du .env à quiconque provoque une erreur.
APP_DEBUG=false

APP_URL=https://rarv.kodemeet.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

# ---------------------------------------------------------------------
#  Base de données — MySQL / MariaDB
# ---------------------------------------------------------------------
#  Sur cPanel, les noms sont préfixés par le compte : `monuser_rarv`.
#  Les deux modules (viewer-ra et labo-formation) partagent CETTE base.
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=            # À REMPLIR
DB_USERNAME=            # À REMPLIR
DB_PASSWORD=            # À REMPLIR

# utf8mb4 obligatoire : le contenu pédagogique contient des accents, des
# guillemets typographiques et des symboles (« °C », « ⌀ »).
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------------
#  Sessions, cache, files d'attente
# ---------------------------------------------------------------------
#  `database` partout : un hébergement mutualisé n'offre ni Redis ni
#  Memcached, et le pilote `file` se comporte mal quand plusieurs processus
#  PHP écrivent en même temps.
# ---------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=rarv.kodemeet.com

# Le cookie de session ne doit jamais transiter en clair.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------
#  Journalisation
# ---------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# ---------------------------------------------------------------------
#  RARV — adresses des deux modules
# ---------------------------------------------------------------------
#  Déploiement par CHEMINS sur un seul domaine : même origine que l'API,
#  donc aucun CORS à traverser et un seul certificat.
# ---------------------------------------------------------------------
RARV_VIEWER_URL=https://rarv.kodemeet.com/viewer
RARV_LAB_URL=https://rarv.kodemeet.com/labo

# Volontairement VIDE : tout est sur la même origine. Ne remplir que si un
# front est un jour déplacé sur un autre domaine.
VIEWER_ORIGINS=

# ---------------------------------------------------------------------
#  Secrets
# ---------------------------------------------------------------------
#  Générer chacun avec :  php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
# ---------------------------------------------------------------------

# Présenté par le SERVEUR du LMS pour obtenir un jeton viewer.
# Ne doit jamais atteindre un navigateur.
RARV_LMS_SECRET=        # À REMPLIR

# Accès aux agrégats du tableau de bord du module labo-formation.
# Non renseigné, ces endpoints répondent 503 : l'absence de secret FERME
# l'accès, elle ne l'ouvre pas.
RARV_DASHBOARD_SECRET=  # À REMPLIR

# Durées de vie, en minutes
RARV_TOKEN_TTL=120
RARV_HANDOFF_TTL=10

# ---------------------------------------------------------------------
#  Traçabilité xAPI
# ---------------------------------------------------------------------
#  `local`  : déclarations conservées en base, visibles au tableau de bord
#  `http`   : envoi vers un vrai LRS (Learning Locker, SCORM Cloud…)
#
#  Le format des déclarations est IDENTIQUE — seul le transport change.
# ---------------------------------------------------------------------
RARV_LRS_DRIVER=local
RARV_LRS_ENDPOINT=
RARV_LRS_USERNAME=
RARV_LRS_PASSWORD=
RARV_LRS_VERSION=1.0.3
RARV_LRS_TIMEOUT=5

# IRI de base des activités xAPI.
# ⚠️ À FIGER DÉFINITIVEMENT avant la première consultation réelle : c'est la
# clé qui relie les déclarations entre elles. La changer plus tard casserait
# le lien avec tout l'historique déjà transmis au LRS.
RARV_XAPI_IRI=https://rarv.kodemeet.com/xapi
RARV_XAPI_HOMEPAGE=https://rarv.kodemeet.com

RARV_ORGANISATION="RARV — plateforme de formation immersive"

# ---------------------------------------------------------------------
#  Règle de complétion
# ---------------------------------------------------------------------
#  all_annotations | min_duration | both
RARV_COMPLETION_MODE=all_annotations
RARV_COMPLETION_MIN_DURATION=60

# ---------------------------------------------------------------------
#  Courriel — attestations de fin de formation
# ---------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=              # À REMPLIR (souvent mail.kodemeet.com)
MAIL_PORT=587
MAIL_USERNAME=          # À REMPLIR
MAIL_PASSWORD=          # À REMPLIR
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@kodemeet.com"
MAIL_FROM_NAME="${APP_NAME}"
