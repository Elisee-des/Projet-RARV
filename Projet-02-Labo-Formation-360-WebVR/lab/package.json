{
  "name": "lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "blocking:generer": "node ../scripts/generer-salle-blocking.mjs ../../Projet-01-Visualiseur-RA-WebXR/api/storage/app/assets3d/environnements/atelier-maintenance-01",
    "assets:generer": "node ../scripts/generer-assets-pedagogiques.mjs ../../Projet-01-Visualiseur-RA-WebXR/api/storage/app/assets3d/environnements/atelier-maintenance-01",
    "decodeurs:copier": "node scripts/copier-decodeurs.mjs",
    "recette:collisions": "node scripts/recette-collisions.mjs",
    "recette:assets": "node scripts/recette-assets.mjs",
    "recette:chaine": "node scripts/recette-chaine.mjs",
    "recette": "npm run recette:collisions && npm run recette:assets && npm run recette:chaine",
    "predev": "npm run decodeurs:copier",
    "dev": "vite",
    "prebuild": "npm run decodeurs:copier",
    "build:wc": "vite build --config vite.config.webcomponent.ts",
    "build": "tsc -b && npm run build:wc && vite build",
    "preview": "vite preview",
