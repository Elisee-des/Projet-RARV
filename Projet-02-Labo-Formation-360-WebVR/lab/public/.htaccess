# Labo de formation — servi sous https://rarv.kodemeet.com/labo/
#
# Copié tel quel dans dist/ par Vite (tout /public l'est).
#
# Rôle : replier les routes internes sur index.html. Sans lui, toute URL qui
# n'existe pas sur le disque remonte au .htaccess de Laravel et reçoit un 404
# du framework au lieu de l'application.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fichiers et dossiers réels servis directement : assets, wasm, décodeurs.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ⚠️ Cible RELATIVE, sans RewriteBase : Apache la résout dans le dossier
    # qui contient ce fichier. Un « /labo/index.html » absolu supposerait que
    # public/ soit la racine du domaine — faux dès que l'application est
    # servie depuis un sous-dossier.
    RewriteRule . index.html [L]
</IfModule>

# --- Types MIME ---------------------------------------------------------
# Les hébergements mutualisés ignorent souvent .wasm et .glb, servis alors en
# application/octet-stream : le décodeur WebAssembly refuse de démarrer et la
# scène reste invisible, sans erreur explicite.
<IfModule mod_mime.c>
    AddType application/wasm            .wasm
    AddType model/gltf-binary           .glb
    AddType model/gltf+json             .gltf
    AddType image/ktx2                  .ktx2
    AddType application/javascript      .mjs
    AddType text/vtt                    .vtt
</IfModule>

# --- Cache --------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|wasm|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # index.html référence les noms hashés : mis en cache, il continuerait à
    # demander des fichiers supprimés au déploiement suivant.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    <FilesMatch "^(draco_|basis_)">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/vtt
</IfModule>
